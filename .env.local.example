# Entorno local SIN Docker (PyCharm, VS Code, terminal). Copie este archivo a .env.
# Docker usa .env.example (allí la base de datos se llama "db" y Redis "redis").
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-cambie-esto-por-una-clave-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de datos de la app. `python manage.py preparar_bd_local` crea este usuario y esta base
# en su PostgreSQL local si no existen (usa la cuenta administradora de POSTGRES_ADMIN_URL).
DATABASE_URL=postgres://crecenta:crecenta@localhost:5432/crecenta
# Cuenta administradora de PostgreSQL (la que creó al instalarlo; suele ser "postgres").
POSTGRES_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Vacío = sin Redis: caché en memoria y tareas en el mismo proceso (lo más simple en local).
# Si instala Redis, ponga redis://localhost:6379/0 y levante el worker de Celery.
REDIS_URL=

TIME_ZONE=America/Santo_Domingo
DEFAULT_CURRENCY=DOP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_VERIFICATION=optional

# IA: fake no hace llamadas externas. Para usar una real: gemini u openai con su clave.
AI_PROVIDER=fake
GEMINI_API_KEY=
OPENAI_API_KEY=
