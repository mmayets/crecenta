# Entorno local (PyCharm, VS Code, terminal). Estos valores se cargan en la tabla
# "parameters" con: python manage.py importar_parametros .env.local.example
# La conexión a la base de datos NO va aquí: copie config/db.example.py a config/db.py.
# La lista completa de parámetros disponibles está en .env.example.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-cambie-esto-por-una-clave-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Vacío = sin Redis: caché en memoria y tareas en el mismo proceso (lo más simple en local).
# Si instala Redis, ponga redis://localhost:6379/0 y levante el worker de Celery.
REDIS_URL=

TIME_ZONE=America/Santo_Domingo
DEFAULT_CURRENCY=DOP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_VERIFICATION=optional

# IA: fake no hace llamadas externas. Para usar una real: gemini u openai con su clave.
AI_PROVIDER=fake
GEMINI_API_KEY=
OPENAI_API_KEY=
