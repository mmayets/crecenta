# Copie este archivo a .env y ajuste los valores. Nunca suba .env al repositorio.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# En producción usa una ruta difícil de adivinar para el admin
DJANGO_ADMIN_URL=admin/
APP_VERSION=1

DATABASE_URL=postgres://crecenta:crecenta@db:5432/crecenta
REDIS_URL=redis://redis:6379/0

TIME_ZONE=America/Santo_Domingo
DEFAULT_CURRENCY=DOP

# Correo (en desarrollo se imprime en consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Crecenta <no-responder@crecenta.app>
ACCOUNT_EMAIL_VERIFICATION=optional

# Inicio de sesión con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA: gemini | openai | fake (fake no hace llamadas externas)
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_LIMIT_PER_HOUR=30
AI_LIMIT_PER_DAY=200
AI_DEBUG_LOG=False

# Almacenamiento S3 compatible para comprobantes (solo producción, opcional)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
